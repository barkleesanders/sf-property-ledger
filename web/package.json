{
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.0",
    "zod": "^4.6.5"
  },
  "description": "Hono frontend for the SF property verification ledger (Wave 5b)",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.144.0"
  },
  "name": "sf-property-ledger-web",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "dev:worker": "wrangler dev",
    "start": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-data.mjs",
    "seed:r2": "node scripts/seed-r2.mjs",
    "build:faq": "esbuild src/faq/faq-island.tsx --bundle --format=esm --minify --target=es2022 --jsx=automatic --jsx-import-source=hono/jsx/dom --outfile=public/faq-island.js && cp src/faq/faq.css public/faq.css",
    "test": "tsx src/faq/faq.test.ts"
  },
  "type": "module",
  "version": "0.5.0"
}
